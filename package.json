{
  "name": "finanzas-personales",
  "version": "1.0.0",
  "description": "Aplicación de finanzas personales para Juan",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "build:client": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install",
    "migrar-storage": "node server/migrarStorage.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:telegram": "node --experimental-vm-modules node_modules/jest/bin/jest.js server/telegram/parser.test.js"
  },
  "keywords": [
    "finanzas",
    "personal",
    "chile"
  ],
  "author": "Juan",
  "license": "MIT",
  "dependencies": {
    "@tesseract.js-data/spa": "^1.0.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "node-telegram-bot-api": "^0.66.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "puppeteer-core": "^25.17.0"
  }
}
