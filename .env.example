# Configuración del Servidor
NODE_ENV=production
PORT=3005

# Servir la web (client/dist) desde este servidor. Por defecto false: la app se usa por el bot de Telegram
# Pon true solo si compilaste el frontend y quieres usar la web
SERVIR_FRONTEND=false

# Base de Datos MariaDB (BD propia, separada de cualquier otra aplicación)
DB_HOST=localhost
DB_PORT=3306
DB_USER=finanzas_juan
DB_PASSWORD=tu_contraseña_segura_aqui
DB_NAME=finanzas_personales_juan

# Sesión
SESSION_SECRET=genera_un_secreto_aleatorio_largo_y_seguro_aqui

# Usuario de la Aplicación (contraseña inicial: cambiar después del primer login)
# La contraseña se hasheará automáticamente en el primer inicio
ADMIN_PASSWORD=cambiar123

# Almacenamiento de archivos: una sola raíz, ordenada por tipo y mes
#   cartolas/{YYYY-MM}/  comprobantes/{YYYY-MM}/  archivos/{YYYY-MM}/  tmp/
# Si queda vacía, en desarrollo se usa storage/ en la raíz del repo (ignorada por git).
# En producción (apps de Basalto): /home/basalto/apps/finanzas-juan/storage
FINANZAS_STORAGE=

# OBSOLETAS: si están definidas siguen mandando para su tipo (con un aviso al arrancar).
# Prefiere FINANZAS_STORAGE y deja estas vacías.
# CARTOLAS_PATH=
# RESPALDOS_PATH=
# UPLOADS_PATH solo se usa para servir en /uploads archivos antiguos

# Bot de Telegram (opcional)
# Si no se configura, el servidor arrancará sin el bot
TELEGRAM_BOT_TOKEN=
# Chat IDs autorizados (separados por coma). Usa /miid en el bot para obtener tu chat ID
TELEGRAM_ALLOWED_CHAT_IDS=

# Gemini (opcional): respaldo para interpretar mensajes libres en el bot de Telegram
# Sin GEMINI_API_KEY el bot usa solo el parser de reglas
GEMINI_API_KEY=
# Modelo (por defecto gemini-2.5-flash si se deja vacío)
GEMINI_MODEL=

# Titular por defecto para /savecard cuando dices "titular yo", "a nombre mio" o "propia"
# Si queda vacío se guarda "Yo"
TITULAR_POR_DEFECTO=
