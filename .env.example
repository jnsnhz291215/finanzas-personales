# Configuración del Servidor
NODE_ENV=production
PORT=3005

# Base de Datos MariaDB (BD propia, separada de cualquier otra aplicación)
DB_HOST=localhost
DB_PORT=3306
DB_USER=finanzas_juan
DB_PASSWORD=tu_contraseña_segura_aqui
DB_NAME=finanzas_personales_juan

# Sesión
SESSION_SECRET=genera_un_secreto_aleatorio_largo_y_seguro_aqui

# Usuario de la Aplicación (contraseña inicial: cambiar después del primer login)
# La contraseña se hasheará automáticamente en el primer inicio
ADMIN_PASSWORD=cambiar123

# Rutas de Almacenamiento (usar rutas absolutas, por ejemplo rutas montadas del NAS)
# Estas rutas deben existir y tener permisos de escritura
UPLOADS_PATH=/ruta/al/nas/finanzas-juan/uploads
CARTOLAS_PATH=/ruta/al/nas/finanzas-juan/cartolas
RESPALDOS_PATH=/ruta/al/nas/finanzas-juan/respaldos

# Bot de Telegram (opcional)
# Si no se configura, el servidor arrancará sin el bot
TELEGRAM_BOT_TOKEN=
# Chat IDs autorizados (separados por coma). Usa /miid en el bot para obtener tu chat ID
TELEGRAM_ALLOWED_CHAT_IDS=
